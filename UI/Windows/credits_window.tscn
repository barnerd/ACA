[node name="v0_7_0" parent="PanelContainer/MarginContainer/VBoxContainer/ScrollContainer/VBoxContainer" instance=ExtResource("2_7j7xc")]
layout_mode = 2
minor_version = 7
entry_header = "Branding & Settings"
entry_log = " • Added Branding, which comes with boot splashes and various underlying systems
 • Added Settings system, including the following:
     • Last version seen, allowing for change log popup when logging in
     • Tribe & equipment settings, remembering last used for both
     • Skip Bootsplash, which jumps right into loading
 • Removed Mines from the map"

[node name="v0_6_0" parent="PanelContainer/MarginContainer/VBoxContainer/ScrollContainer/VBoxContainer" instance=ExtResource("2_7j7xc")]
layout_mode = 2
minor_version = 6
entry_header = "Offline Generation"
entry_log = " • Added boats as their own map layer
 • Moved Terrain Colors and Map Images layers to offline generation so the app will load faster
 • Moved APF flat files to offline generation
 • Added Discord version of the APF format
 • Added internal tool to update single tiles
 • Cleaned up APF errors and surrounding tile images"

[node name="v0_5_0" parent="PanelContainer/MarginContainer/VBoxContainer/ScrollContainer/VBoxContainer" instance=ExtResource("2_7j7xc")]
layout_mode = 2
minor_version = 5
entry_header = "Pathfinding"
entry_log = " • Pathfinding! Left-click to add start point; right-click to add end point and calculate your path.
 • Set your equipment, as it pertains to pathfinding. Path cost is adjusted based on equipment.
 • Set a max tier. Need to avoid Tier 10? Don't want to travel through Tier 9? Set the max tier and pathfinding will go around it.
 • Moved downloads to downloads window under menu"

[node name="v0_4_1" parent="PanelContainer/MarginContainer/VBoxContainer/ScrollContainer/VBoxContainer" instance=ExtResource("2_7j7xc")]
layout_mode = 2
minor_version = 4
release_version = 1
entry_header = " Town Display"
entry_log = " • Ability to edit groups & town information
 • Town Information displayed when clicking on tile
 • Add groups window from menu
 • Left click now scrolls the map
 • Clicking on Towns in Groups Window now take you to map location
 • Map stays centered when zooming
 • Map filters for towns (watchtower, dwelling, buildings)
 • Map filters and menu now expand/collapse by clicking on the header"

[node name="v0_4_0" parent="PanelContainer/MarginContainer/VBoxContainer/ScrollContainer/VBoxContainer" instance=ExtResource("2_7j7xc")]
layout_mode = 2
minor_version = 4
entry_header = "Theming"
entry_log = " • Themed app to closely match Agonia
 • Made scrollbars wider
 • Added coords around map
 • Added grid lines and a toggle to turn them on/off
 • Added Menu to upper right and added credits & change log window
 • Changed default zoom to 24 and range from 1 to 96 (up to 4x size)
 • Expanded map to full 400x400
 • Some backend cleanup & optimization"

[node name="v0_3_1" parent="PanelContainer/MarginContainer/VBoxContainer/ScrollContainer/VBoxContainer" instance=ExtResource("2_7j7xc")]
layout_mode = 2
minor_version = 3
release_version = 1
entry_header = "Encounter Table & Downloads"
entry_log = " • Added scroll bars on monsters list
 • Other small changes based on feedback"

[node name="v0_3_0" parent="PanelContainer/MarginContainer/VBoxContainer/ScrollContainer/VBoxContainer" instance=ExtResource("2_7j7xc")]
layout_mode = 2
minor_version = 3
entry_header = "Encounter Table & Downloads"
entry_log = " • Button to download APF File
 • Button to download map image (use with caution: takes ~1 hour to prepare)
 • Encounter Tiers now visible on the map!
 • Filter the visible tiers via a dropdown
 • Monster Details displayed by Encounter Table
 • Monsters sorted by sorcery requirement, with xp piñata at top, boss at the bottom"

[node name="v0_2_0" parent="PanelContainer/MarginContainer/VBoxContainer/ScrollContainer/VBoxContainer" instance=ExtResource("2_7j7xc")]
